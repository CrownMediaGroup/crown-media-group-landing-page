# ============================================================
# ALL GLORY TO JESUS GLOBAL LLC — .gitignore
# ============================================================

# --- Shell-paste artifacts (JS code accidentally piped into the shell) ---
# Block files matching JS-syntax-fragment patterns from being created at root
/!*
/(*
/)*
/{*
/?*
/c.*
/`*
/console.log*
/process.env*
/db.prepare*
/console.error*
/setTimeout*
/hasOfferCatalog*
/allowed.includes*
/k.includes*
/el.tags*
/city.includes*
/Crown
/OVERBOUGHT
/Request
/[0-9]
/[0-9])
/s

# --- Personal/private content (out of repo) ---
/Agency/personal/private/

# --- Environment & Secrets (NEVER commit these) ---
.env
.env.*
!.env.example
*.env
secrets/
*client_secret*.json
*Google Secret*.json
github-recovery-codes.txt
*.apps.googleusercontent.com*.json

# --- Client project repos (standalone git repos, not submodules) ---
clients/
security/
credentials/
*_credentials.json
*_service_account.json
*service-account*.json
*recovery_code*
*api_key*
*apikey*
*.csv
# Google service account keys (any naming pattern)
agency-automation-*.json
*-d77e3228bafa.json

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.next/
.nuxt/
.cache/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
.pytest_cache/

# --- n8n ---
.n8n/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# --- Editor ---
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# --- Logs ---
logs/
*.log
*.log.*

# --- Uploads & Media (large files) ---
uploads/
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.tar.gz
*.rar
# Exception: hero background video for crownmediagroup.co
!landing-page/assets/video/hero-bg.mp4

# --- Blog video output (large renders, never commit) ---
landing-page/content/blog/video-output/
*.mp3

# --- Audio transcripts (King's lyrics — keep local) ---
tools/audio/transcripts/
tools/audio/cache/
tools/audio/pdfs/
tools/audio/inbox/
tools/audio/.tmp/
tools/audio/analysis/
tools/audio/.suno-corpus.md
tools/audio/.*.log

# --- CRM local db ---
tools/crm/crm.db
tools/daemon/*.exe

# --- Netlify ---
.netlify/

# --- Personal / Sensitive Documents (NEVER commit) ---
assets/personal/
**/*passport*
**/*ssn*
**/*drivers-license*
**/*dl-scan*

# --- Claude Code local settings (contains personal data) ---
.claude/settings.local.json

# --- MCP config (contains API keys — never commit) ---
.mcp.json

# --- n8n MCP tool (nested git repo — tracked separately) ---
tools/n8n-mcp/

# --- Client onboarding system (standalone deployable, own git repo) ---
client-onboarding-system/

# --- Local runtime DBs and caches ---
.claude/memory.db
.claude/skills/
tools/crm/test-screenshots/

# --- Misc ---
.temp/
tmp/

# --- Loose media files at root ---
CMG - Banner*.png
"CMG - Banner*.png"
*.jpg
*.jpeg
*.png
!landing-page/assets/**
!landing-page/logo.png
!landing-page/icons/*.png
!tools/crm/public/favicon.png

# --- Screenshot captures ---
tools/screen/*.png

# --- Stale build artifacts ---
landing-page/landing-page/
.claude/scheduled_tasks.lock

# --- Runtime / MCP / agent state ---
.agents/
.amplify-last-run
.playwright-mcp/

# --- Kingdom Reach runtime artifacts (generated per dispatch) ---
tools/kingdom-reach/output/
tools/kingdom-reach/inbox/
tools/kingdom-reach/logs/
