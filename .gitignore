# ============================================================
# ALL GLORY TO JESUS GLOBAL LLC — .gitignore
# ============================================================

# --- Environment & Secrets (NEVER commit these) ---
.env
.env.*
!.env.example
*.env
secrets/
security/
credentials/
*_credentials.json
*_service_account.json
*service-account*.json
*recovery_code*
*api_key*
*apikey*
*.csv
# Google service account keys (any naming pattern)
agency-automation-*.json
*-d77e3228bafa.json

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.next/
.nuxt/
.cache/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
.pytest_cache/

# --- n8n ---
.n8n/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# --- Editor ---
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# --- Logs ---
logs/
*.log
*.log.*

# --- Uploads & Media (large files) ---
uploads/
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.tar.gz
*.rar
# Exception: hero background video for crownmediagroup.co
!landing-page/assets/video/hero-bg.mp4

# --- CRM local db ---
tools/crm/crm.db
tools/daemon/*.exe

# --- Netlify ---
.netlify/

# --- Personal / Sensitive Documents (NEVER commit) ---
assets/personal/
**/*passport*
**/*ssn*
**/*drivers-license*
**/*dl-scan*

# --- Claude Code local settings (contains personal data) ---
.claude/settings.local.json

# --- Misc ---
.temp/
tmp/
