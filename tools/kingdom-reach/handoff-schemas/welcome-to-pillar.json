{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WELCOME → PILLAR",
  "description": "WELCOME (onboarding complete) hands an active client to PILLAR (retention).",
  "type": "object",
  "required": ["from", "to", "client", "ts"],
  "properties": {
    "from": { "const": "WELCOME" },
    "to":   { "const": "PILLAR" },
    "ts":   { "type": "string", "format": "date-time" },
    "client": {
      "type": "object",
      "required": ["crm_id", "onboarded_at", "tier"],
      "properties": {
        "crm_id":              { "type": "integer" },
        "name":                { "type": "string" },
        "tier":                { "type": "string", "enum": ["starter","growth","premium"] },
        "onboarded_at":        { "type": "string", "format": "date-time" },
        "next_check_in":       { "type": "string", "format": "date" },
        "monthly_deliverables": { "type": "array", "items": { "type": "string" } },
        "primary_contact_email": { "type": "string" },
        "primary_contact_name":  { "type": "string" },
        "milestones": {
          "type": "object",
          "properties": {
            "day_30":  { "type": "string" },
            "day_60":  { "type": "string" },
            "day_90":  { "type": "string" }
          }
        }
      }
    }
  }
}
