{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RADAR → CLOSER",
  "description": "RADAR (reply handler) hands a positive_interest reply to CLOSER (call prep).",
  "type": "object",
  "required": ["from", "to", "reply", "classification", "ts"],
  "properties": {
    "from": { "const": "RADAR" },
    "to":   { "const": "CLOSER" },
    "ts":   { "type": "string", "format": "date-time" },
    "reply": {
      "type": "object",
      "required": ["crm_id", "sender_email", "subject", "body"],
      "properties": {
        "crm_id":       { "type": "integer" },
        "sender_email": { "type": "string", "format": "email" },
        "sender_name":  { "type": "string" },
        "subject":      { "type": "string" },
        "body":         { "type": "string" },
        "gmail_thread_id": { "type": "string" },
        "received_at":  { "type": "string", "format": "date-time" }
      }
    },
    "classification": {
      "type": "object",
      "required": ["category", "confidence"],
      "properties": {
        "category":         { "type": "string", "enum": ["positive_interest","objection","not_interested","referral","auto_reply","bounce","unsubscribe_request","neutral_acknowledgment"] },
        "confidence":       { "type": "number", "minimum": 0, "maximum": 1 },
        "intent_summary":   { "type": "string" },
        "suggested_action": { "type": "string" },
        "key_extract":      { "type": "string" }
      }
    },
    "urgency": { "type": "string", "enum": ["P0","P1","P2","P3"] }
  }
}
